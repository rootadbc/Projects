{
  "manifest_version": 3,
  "name": "slimeView",
  "version": "1.2.2",
  "description": "Local page cleanup with on/off controls and adaptive appearance.",
  "author": "rootadbc",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "slimeView" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
