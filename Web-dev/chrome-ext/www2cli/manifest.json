{
  "manifest_version": 3,
  "name": "www2CLI",
  "version": "1.0.0",
  "description": "A Linux-inspired terminal overlay for your current webpage.",
  "author": "rootadbc",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "background/service-worker.js" },
  "action": { "default_title": "Toggle www2CLI terminal" },
  "commands": {
    "toggle-terminal": { "suggested_key": { "default": "Ctrl+Shift+K" }, "description": "Toggle the www2CLI terminal" }
  },
  "web_accessible_resources": [{ "resources": ["styles/terminal.css"], "matches": ["http://*/*", "https://*/*"] }],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
